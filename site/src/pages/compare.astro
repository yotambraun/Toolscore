---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import JobMap from '../components/JobMap.astro';
import CTASection from '../components/CTASection.astro';
import { compareTools, compareCheckedOn, site } from '../data/site';
---

<BaseLayout
  title="Compare"
  description="Toolscore next to MCP Inspector, the MCP conformance suite, Snyk Agent Scan, Cisco MCP Scanner, DeepEval and Promptfoo: which tool for which job, and where the other tool is the better choice."
>
  <PageHeader
    eyebrow="Positioning"
    title="Which tool <span class='brand-text'>for which job</span>"
    sub="Toolscore checks that the tool really did it, and that the agent told the truth about it. Other MCP tools do other jobs, and several do theirs better than Toolscore would. Here is which to reach for."
  />

  <section class="section">
    <div class="wrap">
      <div class="mb-8 max-w-2xl">
        <p class="eyebrow mb-3">By job</p>
        <h2 class="h2">Reach for the right one</h2>
        <p class="lead mt-4">
          Each line about another tool comes from that tool's own documentation, read on
          {compareCheckedOn}. Sources and detail are in the
          <a class="text-brand underline-offset-4 hover:underline" href={`${site.docs}comparison.html`} target="_blank" rel="noopener">comparison guide</a>.
        </p>
      </div>

      <JobMap />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow mb-3">The other tools</p>
        <h2 class="h2">What each is best at</h2>
        <p class="lead mx-auto mt-4 max-w-xl">
          They work well together: the conformance suite for the protocol, Inspector when something
          fails, a scanner before you publish, and Toolscore as the deterministic gate in CI.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          compareTools.map((t) => (
            <div class="card flex flex-col p-7">
              <h3 class="text-xl font-bold text-ink">
                <a class="hover:text-brand" href={t.href} rel="noopener">{t.name}</a>
              </h3>
              <p class="mt-3 text-pretty text-muted">{t.best}</p>
              <a class="mt-4 break-all font-mono text-xs text-faint hover:text-brand" href={t.href} rel="noopener">
                {t.href.replace('https://', '')}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card mx-auto max-w-3xl p-8 text-center sm:p-10">
        <p class="eyebrow mb-3">The bottom line</p>
        <p class="text-balance text-xl font-semibold leading-relaxed text-ink sm:text-2xl">
          Correct tool calls are not enough. Toolscore checks that the tool really did it, and that
          the agent told the truth about it:
          <span class="brand-text">deterministic, offline, $0 per run.</span>
        </p>
      </div>
    </div>
  </section>

  <CTASection
    heading="Add the deterministic gate to your CI"
    sub="pip install tool-scorer, grade your server, and check what your agent said."
  />
</BaseLayout>
