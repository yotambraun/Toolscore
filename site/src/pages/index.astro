---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AudienceSplit from '../components/AudienceSplit.astro';
import StepFlow from '../components/StepFlow.astro';
import FeatureCard from '../components/FeatureCard.astro';
import JobMap from '../components/JobMap.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';
import { features, foundWith, url } from '../data/site';
---

<BaseLayout>
  <Hero />

  <!-- Proof strip -->
  <section class="py-6">
    <div class="wrap">
      <div class="card flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          <span class="font-semibold text-ink">{foundWith.heading}:</span>
          two bugs in the official MCP memory server, fixed upstream in
          {foundWith.items.map((item, i) => (
            <>
              {i > 0 && ' and '}
              <a class="font-mono text-brand hover:underline" href={item.prUrl} target="_blank" rel="noopener">{item.pr}</a>
            </>
          ))}.
        </p>
        <a class="shrink-0 text-sm text-brand hover:underline" href={url('mcp')}>How they were found →</a>
      </div>
      <div class="card mt-3 flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          <span class="font-semibold text-ink">Now caught automatically:</span>
          the effect probes flag the #4887 bug (<span class="font-mono">probe-silent-noop</span>) in
          <span class="font-mono">server-memory@2026.8.31</span>, the release before the fix, and pass
          the fixed <span class="font-mono">2.0.1</span>. No configuration.
        </p>
        <a class="shrink-0 text-sm text-brand hover:underline" href="https://github.com/yotambraun/toolscore/tree/main/examples/mcp_memory_probes" target="_blank" rel="noopener">Commands and output →</a>
      </div>
    </div>
  </section>

  <AudienceSplit />

  <StepFlow />

  <!-- Feature grid -->
  <section class="section">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow mb-3">What you get</p>
        <h2 class="h2">Built to live in your test suite</h2>
        <p class="lead mx-auto mt-4 max-w-xl">
          Not a dashboard you check after the fact — a deterministic gate that fails the build the
          moment tool-calling breaks.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => <FeatureCard title={f.title} body={f.body} icon={f.icon} />)}
      </div>
    </div>
  </section>

  <!-- Comparison teaser -->
  <section class="section">
    <div class="wrap">
      <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-xl">
          <p class="eyebrow mb-3">Next to other MCP tools</p>
          <h2 class="h2">Which tool for which job</h2>
          <p class="lead mt-4">
            MCP Inspector, the conformance suite, security scanners, DeepEval and Promptfoo each do
            a job, several better than Toolscore would. Toolscore is the deterministic check that
            the tool did it and the agent told the truth.
          </p>
        </div>
        <Button href={url('compare')} variant="secondary" class="shrink-0">See the comparison →</Button>
      </div>

      <JobMap />
    </div>
  </section>

  <CTASection />
</BaseLayout>
